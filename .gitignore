# Actual media, records, settings, run logs, references, caches and exports.
/local/
/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/
.env
.env.*
!.env.example
*.private.*
*.log
Thumbs.db
.DS_Store
